---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Project cards pull straight from md frontmatter (tags: [project]).
// To list a post here: add `tags: [project]` + optional `featured_image` / `tech` to its frontmatter.
const projectPosts = await getCollection('blog', ({ data }) => {
    return data.publish !== false && (data.tags ?? []).includes('project');
});

// Newest first, same as blog.astro / tag/[tag].astro
projectPosts.sort((a, b) => {
    const dateA = a.data.created_date ?? new Date(0);
    const dateB = b.data.created_date ?? new Date(0);
    return dateB.valueOf() - dateA.valueOf();
});

const projects = projectPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description ?? '',
    previewImage: post.data.featured_image ?? undefined,
    blogSlug: post.data.slug ?? post.id,
    tech: post.data.tech ?? [],
}));

// Fail build if two project posts collide on slug (would silently overwrite each other's card link)
const seenSlugs = new Set();
for (const p of projects) {
    if (seenSlugs.has(p.blogSlug)) {
        throw new Error(`[projects.astro] duplicate blogSlug "${p.blogSlug}" across project posts`);
    }
    seenSlugs.add(p.blogSlug);
}
---

