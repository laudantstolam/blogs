---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import GraphView from '../components/GraphView.astro';
import { getCollection } from 'astro:content';
import { getUrl } from '../utils/url';

// Helper function to get a valid timestamp or fallback
function getValidTimestamp(date: Date | null | undefined): number {
    if (!date) return 0;
    const timestamp = date.getTime();
    return isNaN(timestamp) ? 0 : timestamp;
}

const allPosts = await getCollection('blog');
const posts = allPosts
    .filter(post => post.data.publish)
    .sort((a, b) => {
        const dateA = getValidTimestamp(a.data.created_date);
        const dateB = getValidTimestamp(b.data.created_date);
        return dateB - dateA;
    });

// Get featured post (most recent)
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 5);
const olderPosts = posts.slice(5);

// Get all tags and their counts
const tagCounts = new Map<string, number>();
posts.forEach(post => {
    if (post.data.tags) {
        post.data.tags.forEach(tag => {
            tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
        });
    }
});

// Sort tags by count (descending) then alphabetically
const sortedTags = Array.from(tagCounts.entries())
    .sort((a, b) => {
        if (b[1] !== a[1]) return b[1] - a[1];
        return a[0].localeCompare(b[0]);
    });

// Calculate stats
const totalPosts = posts.length;
const totalTags = tagCounts.size;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Blog" description="Explore our collection of articles, ideas, insights, and everything in between." />
        <style>
            /* ==================== BASE ==================== */
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                margin: 0;
            }

            main {
                flex: 1;
                width: 100%;
                max-width: 1400px;
                margin: 0 auto;
                padding: 1rem 1.5rem 3rem;
            }

            /* Reduced motion */
            @media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
            }

            /* Focus states */
            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

            :focus:not(:focus-visible) {
                outline: none;
            }

            /* ==================== BENTO GRID LAYOUT ==================== */
            .bento-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                grid-auto-rows: minmax(80px, auto);
                gap: 1rem;
                margin-bottom: 2rem;
            }

            .bento-card {
                background: rgba(var(--gray-light), 0.5);
                border: 1px solid rgba(var(--gray), 0.1);
                border-radius: 1.25rem;
                padding: 1.25rem;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .bento-card:hover {
                transform: translate3d(0, -2px, 0);
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
            }

            /* ==================== FEATURED POST - Large card ==================== */
            .featured-card {
                grid-column: span 12;
                grid-row: span 3;
                background: linear-gradient(
                    135deg,
                    rgba(var(--accent), 0.08) 0%,
                    rgba(var(--gray-light), 0.7) 100%
                );
                border-color: rgba(var(--accent), 0.15);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                overflow: hidden;
            }

            .featured-card::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -30%;
                width: 60%;
                height: 150%;
                background: radial-gradient(circle, rgba(var(--accent), 0.06) 0%, transparent 70%);
                pointer-events: none;
            }

            .featured-label {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.35rem 0.75rem;
                background: var(--accent);
                color: white;
                font-size: 0.7rem;
                font-weight: 600;
                border-radius: 2rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                width: fit-content;
            }

            .featured-label svg {
                width: 12px;
                height: 12px;
            }

            .featured-content {
                position: relative;
                z-index: 1;
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 1rem 0;
            }

            .featured-title {
                font-size: 2rem;
                font-weight: 700;
                color: rgb(var(--black));
                margin-bottom: 0.5rem;
                line-height: 1.2;
            }

            .featured-title a {
                color: inherit;
                text-decoration: none;
                transition: color 0.2s ease;
            }

            .featured-title a:hover {
                color: var(--accent);
            }

            .featured-excerpt {
                font-size: 1rem;
                color: rgb(var(--gray));
                line-height: 1.6;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
                max-width: 500px;
            }

            .featured-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .featured-date {
                font-size: 0.85rem;
                color: rgb(var(--gray));
            }

            .featured-cta {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.6rem 1.2rem;
                background: var(--accent);
                color: white;
                font-weight: 500;
                font-size: 0.9rem;
                border-radius: 0.6rem;
                text-decoration: none;
                cursor: pointer;
                transition: transform 0.15s ease, box-shadow 0.2s ease;
            }

            .featured-cta:hover {
                transform: translate3d(0, -2px, 0);
                box-shadow: 0 4px 12px rgba(35, 55, 255, 0.35);
                color: white;
                text-decoration: none;
            }

            .featured-cta svg {
                width: 16px;
                height: 16px;
                transition: transform 0.2s ease;
            }

            .featured-cta:hover svg {
                transform: translate3d(3px, 0, 0);
            }

            /* ==================== STATS CARD ==================== */
            .stats-card {
                grid-column: span 3;
                grid-row: span 2;
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 1rem;
            }

            .stats-row {
                display: flex;
                gap: 1rem;
            }

            .stat-box {
                flex: 1;
                text-align: center;
                padding: 0.75rem;
                background: rgba(var(--gray-light), 0.6);
                border-radius: 0.75rem;
            }

            .stat-value {
                font-size: 1.75rem;
                font-weight: 700;
                color: var(--accent);
                line-height: 1;
            }

            .stat-name {
                font-size: 0.75rem;
                color: rgb(var(--gray));
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-top: 0.25rem;
            }

            /* ==================== TAGS CARD ==================== */
            .tags-card {
                grid-column: span 9;
                grid-row: span 2;
                display: flex;
                flex-direction: column;
            }

            .card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 0.75rem;
            }

            .card-title {
                font-size: 0.9rem;
                font-weight: 600;
                color: rgb(var(--black));
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .card-title svg {
                width: 16px;
                height: 16px;
                color: var(--accent);
            }

            .see-all {
                font-size: 0.8rem;
                color: var(--accent);
                text-decoration: none;
                font-weight: 500;
            }

            .see-all:hover {
                text-decoration: underline;
            }

            .tags-cloud {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                flex: 1;
                align-content: flex-start;
                overflow: hidden;
            }

            .tag-pill {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                padding: 0.4rem 0.75rem;
                background: rgba(var(--gray-light), 0.8);
                color: rgb(var(--gray-dark));
                border-radius: 2rem;
                font-size: 0.8rem;
                font-weight: 500;
                text-decoration: none;
                border: 1px solid rgba(var(--gray), 0.1);
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
            }

            .tag-pill:hover {
                background: var(--accent);
                color: white;
                border-color: var(--accent);
                text-decoration: none;
            }

            .tag-pill .count {
                font-size: 0.7rem;
                opacity: 0.7;
            }

            /* ==================== GRAPH CARD ==================== */
            .graph-card {
                grid-column: span 4;
                grid-row: span 3;
                display: flex;
                flex-direction: column;
                padding: 1rem;
            }

            .graph-wrapper {
                flex: 1;
                min-height: 280px;
                border-radius: 0.75rem;
                overflow: hidden;
            }

            /* ==================== RECENT POSTS CARD ==================== */
            .recent-card {
                grid-column: span 8;
                grid-row: span 7;
                display: flex;
                flex-direction: column;
            }

            .recent-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 0.75rem;
                flex-wrap: wrap;
                gap: 0.75rem;
            }

            .recent-title-group {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .search-box {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.4rem 0.75rem;
                background: rgba(var(--gray-light), 0.8);
                border: 1px solid rgba(var(--gray), 0.1);
                border-radius: 0.6rem;
                flex: 1;
                max-width: 300px;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

            .search-box:focus-within {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(var(--accent), 0.1);
            }

            .search-box svg {
                width: 16px;
                height: 16px;
                color: rgb(var(--gray));
                flex-shrink: 0;
            }

            .search-input {
                flex: 1;
                border: none;
                background: transparent;
                font-size: 0.85rem;
                color: rgb(var(--black));
                outline: none;
            }

            .search-input::placeholder {
                color: rgb(var(--gray));
            }

            .view-toggle {
                display: flex;
                gap: 0.25rem;
                padding: 0.25rem;
                background: rgba(var(--gray-light), 0.8);
                border-radius: 0.5rem;
            }

            .view-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border: none;
                background: transparent;
                color: rgb(var(--gray));
                border-radius: 0.4rem;
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

            .view-btn:hover {
                color: rgb(var(--gray-dark));
                background: rgba(var(--gray), 0.1);
            }

            .view-btn.active {
                background: rgb(var(--gray-light));
                color: var(--accent);
            }

            [data-theme='dark'] .view-btn.active {
                background: rgba(255, 255, 255, 0.1);
            }

            .view-btn svg {
                width: 16px;
                height: 16px;
            }

            .post-list {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
                gap: 1.25rem;
            }

            /* List view for posts */
            .post-list.list-view {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .post-list.list-view :global(article) {
                display: flex;
                flex-direction: row;
                max-height: 150px;
            }

            .post-list.list-view :global(article .card-content) {
                flex-direction: row;
                align-items: center;
                padding: 0.5rem 1rem;
            }

            .post-list.list-view :global(article .main-content) {
                flex: 1;
                min-width: 0;
            }

            .post-list.list-view :global(article .title) {
                font-size: 1.1rem;
                margin-top: 0;
            }

            .post-list.list-view :global(article .description) {
                display: none;
            }

            .post-list.list-view :global(article .footer) {
                border-top: none;
                padding-top: 0;
                margin-top: 0;
                flex-shrink: 0;
            }

            /* ==================== ALL POSTS SECTION ==================== */
            .all-posts-section {
                margin-top: 1rem;
            }

            .section-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 1.25rem;
                padding-bottom: 0.75rem;
                border-bottom: 1px solid rgba(var(--gray), 0.1);
            }

            .section-title {
                font-size: 1.25rem;
                font-weight: 700;
                color: rgb(var(--black));
            }

            .view-toggle {
                display: flex;
                gap: 0.25rem;
                padding: 0.25rem;
                background: rgba(var(--gray-light), 0.8);
                border-radius: 0.5rem;
            }

            .view-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border: none;
                background: transparent;
                color: rgb(var(--gray));
                border-radius: 0.4rem;
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

            .view-btn:hover {
                color: rgb(var(--gray-dark));
                background: rgba(var(--gray), 0.1);
            }

            .view-btn.active {
                background: rgb(var(--gray-light));
                color: var(--accent);
            }

            [data-theme='dark'] .view-btn.active {
                background: rgba(255, 255, 255, 0.1);
            }

            .view-btn svg {
                width: 18px;
                height: 18px;
            }

            /* ==================== EMPTY STATE ==================== */
            .empty-state {
                text-align: center;
                padding: 3rem 1rem;
                color: rgb(var(--gray));
            }

            /* ==================== RESPONSIVE ==================== */
            @media (max-width: 1024px) {
                .bento-grid {
                    grid-template-columns: repeat(6, 1fr);
                }

                .featured-card {
                    grid-column: span 6;
                    grid-row: span 3;
                }

                .stats-card {
                    grid-column: span 2;
                    grid-row: span 2;
                }

                .tags-card {
                    grid-column: span 4;
                    grid-row: span 2;
                }

                .graph-card {
                    grid-column: span 2;
                    grid-row: span 3;
                }

                .recent-card {
                    grid-column: span 4;
                    grid-row: span 7;
                }

                .featured-title {
                    font-size: 1.5rem;
                }
            }

            @media (max-width: 768px) {
                main {
                    padding: 0.75rem 1rem 2rem;
                }

                .bento-grid {
                    grid-template-columns: 1fr;
                    gap: 0.875rem;
                }

                .featured-card,
                .stats-card,
                .tags-card,
                .graph-card,
                .recent-card {
                    grid-column: span 1;
                }

                .featured-card {
                    grid-row: span 2;
                    padding: 1.25rem;
                }

                .stats-card {
                    grid-row: span 1;
                }

                .tags-card {
                    grid-row: span 1;
                }

                .graph-card {
                    grid-row: span 2;
                }

                .recent-card {
                    grid-row: span 3;
                }

                .featured-title {
                    font-size: 1.35rem;
                }

                .featured-excerpt {
                    font-size: 0.9rem;
                    -webkit-line-clamp: 2;
                }

                .graph-wrapper {
                    min-height: 220px;
                }

                .posts-grid {
                    grid-template-columns: 1fr;
                }

                .stat-value {
                    font-size: 1.5rem;
                }
            }

            @media (max-width: 480px) {
                .featured-footer {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .stats-row {
                    gap: 0.5rem;
                }

                .stat-box {
                    padding: 0.5rem;
                }

                .stat-value {
                    font-size: 1.25rem;
                }

                .post-item {
                    padding: 0.75rem;
                }

                .recent-header {
                    flex-direction: column;
                    align-items: stretch;
                }

                .recent-title-group {
                    justify-content: center;
                }

                .search-box {
                    max-width: 100%;
                }

                .view-toggle {
                    align-self: center;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <!-- Bento Grid Layout -->
            <div class="bento-grid">
                <!-- Featured Post - Intro -->
                <article class="bento-card featured-card">
                    <div class="featured-label">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                        Blog
                    </div>
                    <div class="featured-content">
                        <h1 class="featured-title">
                            All Blogs
                        </h1>
                        <p class="featured-excerpt">See My Awesome Posts ;)</p>
                    </div>
                </article>

                <!-- Stats Card -->
                <div class="bento-card stats-card">
                    <div class="stats-row">
                        <div class="stat-box">
                            <div class="stat-value">{totalPosts}</div>
                            <div class="stat-name">Posts</div>
                        </div>
                        <div class="stat-box">
                            <div class="stat-value">{totalTags}</div>
                            <div class="stat-name">Topics</div>
                        </div>
                    </div>
                </div>

                <!-- Tags Card -->
                <div class="bento-card tags-card">
                    <div class="card-header">
                        <h2 class="card-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                                <circle cx="7" cy="7" r="1" fill="currentColor"/>
                            </svg>
                            Topics
                        </h2>
                    </div>
                    <div class="tags-cloud">
                        {sortedTags.slice(0, 10).map(([tag, count]) => (
                            <a href={getUrl(`/tag/${tag}/`)} class="tag-pill">
                                {tag}
                                <span class="count">({count})</span>
                            </a>
                        ))}
                    </div>
                </div>

                <!-- Graph Card -->
                <div class="bento-card graph-card">
                    <div class="card-header">
                        <h2 class="card-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="12" cy="12" r="3"/>
                                <circle cx="19" cy="5" r="2"/>
                                <circle cx="5" cy="5" r="2"/>
                                <circle cx="19" cy="19" r="2"/>
                                <circle cx="5" cy="19" r="2"/>
                                <path d="M12 9V5M12 19v-4M9 12H5M19 12h-4"/>
                            </svg>
                            Knowledge Graph
                        </h2>
                        <a href={getUrl('/graph/')} class="see-all">Fullscreen</a>
                    </div>
                    <div class="graph-wrapper">
                        <GraphView height="100%" showControls={true} />
                    </div>
                </div>

                <!-- Recent Posts Card -->
                <div class="bento-card recent-card">
                    <div class="recent-header">
                        <div class="recent-title-group">
                            <h2 class="card-title">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                    <line x1="3" y1="10" x2="21" y2="10"/>
                                </svg>
                                All Posts
                            </h2>
                        </div>
                        <div class="search-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="M21 21l-4.35-4.35"/>
                            </svg>
                            <input type="text" id="search-input" class="search-input" placeholder="Search posts..." />
                        </div>
                        <div class="view-toggle">
                            <button class="view-btn active" data-view="list" aria-label="List view">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <line x1="3" y1="6" x2="21" y2="6"/>
                                    <line x1="3" y1="12" x2="21" y2="12"/>
                                    <line x1="3" y1="18" x2="21" y2="18"/>
                                </svg>
                            </button>
                            <button class="view-btn" data-view="grid" aria-label="Grid view">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="3" y="3" width="7" height="7"/>
                                    <rect x="14" y="3" width="7" height="7"/>
                                    <rect x="3" y="14" width="7" height="7"/>
                                    <rect x="14" y="14" width="7" height="7"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="post-list" id="post-list">
                        {posts.map((post) => (
                            <BlogCard
                                title={post.data.title}
                                description={post.data.description ?? undefined}
                                date={post.data.created_date ?? undefined}
                                slug={post.data.slug ?? post.id}
                            />
                        ))}
                    </div>
                </div>
            </div>

            <!-- All Posts Section - Removed (all posts shown in Recent Posts card) -->

            {posts.length === 0 && (
                <div class="empty-state">
                    <p>No posts found. Check back soon!</p>
                </div>
            )}
        </main>
        <Footer />

        <script>
            // View toggle functionality
            const viewButtons = document.querySelectorAll('.view-btn');
            const postList = document.getElementById('post-list');
            const VIEW_KEY = 'blog-view-preference';

            function setView(view: string) {
                viewButtons.forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-view') === view);
                });

                if (postList) {
                    if (view === 'list') {
                        postList.classList.add('list-view');
                    } else {
                        postList.classList.remove('list-view');
                    }
                }

                localStorage.setItem(VIEW_KEY, view);
            }

            viewButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const view = btn.getAttribute('data-view');
                    if (view) setView(view);
                });
            });

            // Restore view preference - default to list view
            const savedView = localStorage.getItem(VIEW_KEY) || 'list';
            setView(savedView);

            // Search functionality
            const searchInput = document.getElementById('search-input') as HTMLInputElement;
            if (searchInput && postList) {
                searchInput.addEventListener('input', (e: Event) => {
                    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
                    const blogCards = postList.querySelectorAll('.blog-card');

                    blogCards.forEach(card => {
                        const title = card.querySelector('.title')?.textContent?.toLowerCase() || '';
                        const isVisible = title.includes(searchTerm);
                        (card as HTMLElement).style.display = isVisible ? '' : 'none';
                    });
                });
            }
        </script>
    </body>
</html>
