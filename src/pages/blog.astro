---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import GraphView from '../components/GraphView.astro';
import { getCollection } from 'astro:content';
import { getUrl } from '../utils/url';

// Helper function to get a valid timestamp or fallback
function getValidTimestamp(date: Date | null | undefined): number {
    if (!date) return 0;
    const timestamp = date.getTime();
    return isNaN(timestamp) ? 0 : timestamp;
}

const allPosts = await getCollection('blog');
const posts = allPosts
    .filter(post => post.data.publish)
    .sort((a, b) => {
        const dateA = getValidTimestamp(a.data.created_date);
        const dateB = getValidTimestamp(b.data.created_date);
        return dateB - dateA;
    });

// Get all tags and their counts
const tagCounts = new Map<string, number>();
posts.forEach(post => {
    if (post.data.tags) {
        post.data.tags.forEach(tag => {
            tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
        });
    }
});

// Sort tags by count (descending) then alphabetically
const sortedTags = Array.from(tagCounts.entries())
    .sort((a, b) => {
        if (b[1] !== a[1]) return b[1] - a[1];
        return a[0].localeCompare(b[0]);
    });

// Calculate stats
const totalPosts = posts.length;
const totalTags = tagCounts.size;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Blog" description="Explore our collection of articles, ideas, insights, and everything in between." />
        <style>
            /* ==================== BASE ==================== */
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                margin: 0;
            }

            .blog-main {
                flex: 1;
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
                padding: 2rem 1.5rem 4rem;
            }

            .blog-wrap {
                display: flex;
                gap: 3rem;
                align-items: flex-start;
            }

            /* ==================== STICKY RAIL ==================== */
            .rail {
                width: 260px;
                flex-shrink: 0;
                position: sticky;
                top: 1.5rem;
                font-family: var(--font-mono);
            }

            .rail-graph {
                margin-top: 1.5rem;
            }

            .rail-graph-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 0.5rem;
            }

            .rail-graph-title {
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: rgb(var(--gray));
            }

            .rail-graph-expand {
                font-size: 0.68rem;
                color: var(--accent);
                text-decoration: none;
            }

            .rail-graph-expand:hover {
                text-decoration: underline;
            }

            .rail-graph-wrapper {
                height: 220px;
                border: 1px solid rgba(var(--black), 0.12);
            }

            .rail-graph-wrapper :global(.graph-container) {
                height: 100% !important;
            }

            .rail-title {
                font-size: 2.5rem;
                line-height: 1.05;
                margin-bottom: 0.4rem;
            }

            .rail-desc {
                font-family: var(--font-body);
                font-size: 1.0rem;
                color: rgb(var(--gray));
                margin: 0 0 1.25rem;
            }

            .rail-stat {
                font-size: 1.0rem;
                color: rgb(var(--gray));
                margin-bottom: 0.25rem;
            }

            .rail-stat b {
                color: var(--accent);
                font-size: 1.2rem;
            }

            .search-box {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.5rem 0.6rem;
                border: 1px solid rgba(var(--gray), 0.25);
                margin-top: 1.5rem;
                margin-bottom: 0.75rem;
                transition: border-color 0.2s ease;
            }

            .search-box svg {
                width: 13px;
                height: 13px;
                color: rgb(var(--gray));
                flex-shrink: 0;
            }

            .search-input {
                flex: 1;
                border: none;
                background: transparent;
                font-family: var(--font-mono);
                font-size: 0.78rem;
                color: rgb(var(--black));
                outline: none;
                min-width: 0;
                width: 100%;
            }

            .search-input::placeholder {
                color: rgb(var(--gray));
            }

            .search-input::selection {
                background: rgba(var(--gray), 0.25);
                color: rgb(var(--black));
            }

            .search-input:focus-visible {
                outline: none;
            }

            .filter-pills {
                display: flex;
                flex-wrap: wrap;
                gap: 0.4rem;
            }

            .filter-pill {
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
                padding: 0.4rem 0.75rem;
                border: 1px solid rgba(var(--black), 0.15);
                color: rgb(var(--gray));
                font-family: var(--font-mono);
                font-size: 0.85rem;
                cursor: pointer;
                transition: all 0.2s ease;
            }

            .filter-pill:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .filter-pill.active {
                background: var(--accent);
                border-color: var(--accent);
                color: rgb(var(--gray-light));
            }

            .clear-filter {
                display: none;
                font-family: var(--font-mono);
                font-size: 0.7rem;
                color: rgb(var(--gray));
                cursor: pointer;
                padding: 0.3rem 0;
                border: none;
                background: none;
                margin-top: 0.5rem;
                text-decoration: underline;
            }

            .clear-filter.visible {
                display: inline-block;
            }

            /* ==================== FEED ==================== */
            .feed {
                position: relative;
                flex: 1;
                min-width: 0;
                border-left: 1px solid rgba(var(--black), 0.12);
            }

            .feed-progress {
                position: absolute;
                left: -1px;
                top: 0;
                width: 1px;
                height: 100%;
                background: var(--accent);
                transform: scaleY(0);
                transform-origin: top;
            }

            .empty-state,
            .no-results {
                padding: 3rem 0 3rem 2rem;
                color: rgb(var(--gray));
            }

            .no-results {
                display: none;
            }

            .no-results.visible {
                display: block;
            }

            .empty-state p,
            .no-results p {
                margin: 0;
                font-size: 0.95rem;
            }

            /* ==================== REDUCED MOTION ==================== */
            @media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
            }

            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

            :focus:not(:focus-visible) {
                outline: none;
            }

            /* ==================== RESPONSIVE ==================== */
            @media (max-width: 768px) {
                .blog-main {
                    padding: 1.5rem 1rem 2rem;
                }

                .blog-wrap {
                    flex-direction: column;
                    gap: 1.5rem;
                }

                .rail {
                    position: static;
                    width: 100%;
                }

                .rail-title {
                    font-size: 1.6rem;
                }

                .filter-pills {
                    margin-bottom: 0.5rem;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="blog-main">
            <div class="blog-wrap">
                <aside class="rail">
                    <h1 class="rail-title">All<br />Posts</h1>
                    <p class="rail-desc">I luuuuuve Obsidian ;)</p>
                    <div class="rail-stat"><b>{totalPosts}</b> posts</div>
                    <div class="rail-stat"><b>{totalTags}</b> topics</div>

                    <div class="rail-graph">
                        <div class="rail-graph-header">
                            <span class="rail-graph-title">Graph</span>
                            <a href={getUrl('/graph/')} class="rail-graph-expand">Expand →</a>
                        </div>
                        <div class="rail-graph-wrapper">
                            <GraphView height="220px" showControls={false} />
                        </div>
                    </div>

                    <div class="search-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="M21 21l-4.35-4.35"/>
                        </svg>
                        <input type="text" id="search-input" class="search-input" placeholder="search..." />
                    </div>
                    <div class="filter-pills" id="filter-pills">
                        {sortedTags.map(([tag]) => (
                            <button class="filter-pill" data-tag={tag.toLowerCase()}>{tag}</button>
                        ))}
                    </div>
                    <button class="clear-filter" id="clear-filter">clear filters</button>
                </aside>

                <div class="feed" id="post-list">
                    <div class="feed-progress" id="feed-progress"></div>
                    {posts.map((post) => (
                        <BlogCard
                            title={post.data.title}
                            description={post.data.description ?? undefined}
                            date={post.data.created_date ?? undefined}
                            slug={post.data.slug ?? post.id}
                            tags={post.data.tags ?? []}
                            timeline={true}
                        />
                    ))}
                    <div class="no-results" id="no-results">
                        <p>No posts match your search.</p>
                    </div>
                    {posts.length === 0 && (
                        <div class="empty-state">
                            <p>No posts found. Check back soon!</p>
                        </div>
                    )}
                </div>
            </div>
        </main>
        <Footer />

        <script>
            import gsap from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';
            gsap.registerPlugin(ScrollTrigger);

            // Elements
            const searchInput = document.getElementById('search-input') as HTMLInputElement;
            const feed = document.getElementById('post-list');
            const filterPills = document.querySelectorAll('.filter-pill');
            const clearFilter = document.getElementById('clear-filter');
            const noResults = document.getElementById('no-results');

            let activeTags: Set<string> = new Set();
            let searchTerm = '';

            function filterPosts() {
                if (!feed) return;

                const blogCards = Array.from(feed.querySelectorAll('.blog-card')) as HTMLElement[];
                let visibleCount = 0;

                blogCards.forEach(card => {
                    const title = card.querySelector('.title')?.textContent?.toLowerCase() || '';
                    const cardTags = card.dataset.tags?.toLowerCase().split(',').filter(t => t) || [];

                    const matchesSearch = !searchTerm || title.includes(searchTerm);
                    const matchesTags = activeTags.size === 0 ||
                        Array.from(activeTags).every(tag => cardTags.includes(tag));

                    const isVisible = matchesSearch && matchesTags;
                    const wasHidden = card.style.display === 'none';

                    if (isVisible) {
                        visibleCount++;
                        if (wasHidden) {
                            card.style.display = '';
                            gsap.fromTo(card, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' });
                        }
                    } else if (!wasHidden) {
                        gsap.to(card, {
                            opacity: 0,
                            duration: 0.15,
                            ease: 'power2.in',
                            onComplete: () => { card.style.display = 'none'; }
                        });
                    }
                });

                if (noResults) {
                    noResults.classList.toggle('visible', visibleCount === 0);
                }

                if (clearFilter) {
                    clearFilter.classList.toggle('visible', activeTags.size > 0 || searchTerm.length > 0);
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', (e: Event) => {
                    searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
                    filterPosts();
                });
            }

            filterPills.forEach(pill => {
                pill.addEventListener('click', () => {
                    const tag = (pill as HTMLElement).dataset.tag;
                    if (!tag) return;

                    if (activeTags.has(tag)) {
                        activeTags.delete(tag);
                        pill.classList.remove('active');
                    } else {
                        activeTags.add(tag);
                        pill.classList.add('active');
                    }

                    filterPosts();
                });
            });

            if (clearFilter) {
                clearFilter.addEventListener('click', () => {
                    activeTags.clear();
                    searchTerm = '';
                    if (searchInput) searchInput.value = '';
                    filterPills.forEach(p => p.classList.remove('active'));
                    filterPosts();
                });
            }

            // Entrance: rail fades/slides in, feed items stagger up
            const railEls = document.querySelectorAll('.rail > *');
            gsap.set(railEls, { opacity: 0, y: 12 });
            gsap.to(railEls, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', stagger: 0.05 });

            if (feed) {
                const cards = feed.querySelectorAll('.blog-card');
                gsap.set(cards, { opacity: 0, y: 16 });

                ScrollTrigger.batch(cards, {
                    start: 'top 92%',
                    onEnter: (batch) => {
                        gsap.to(batch, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', stagger: 0.07 });
                    },
                    once: true,
                });

                // Timeline progress line: fills as the feed scrolls through view
                gsap.to('#feed-progress', {
                    scaleY: 1,
                    ease: 'none',
                    scrollTrigger: {
                        trigger: feed,
                        start: 'top 20%',
                        end: 'bottom bottom',
                        scrub: 0.3,
                    },
                });
            }

            // Graph sync: highlight the matching node in the mini graph while hovering a feed row
            function setupGraphSync() {
                if (!feed) return;

                const blogCards = feed.querySelectorAll('.blog-card');

                blogCards.forEach(card => {
                    const postId = (card as HTMLElement).dataset.postId;
                    if (!postId) return;

                    card.addEventListener('mouseenter', () => {
                        window.dispatchEvent(new CustomEvent('graph-highlight-post', {
                            detail: { postId }
                        }));
                    });

                    card.addEventListener('mouseleave', () => {
                        window.dispatchEvent(new CustomEvent('graph-clear-highlight'));
                    });
                });
            }

            setupGraphSync();
        </script>
    </body>
</html>
