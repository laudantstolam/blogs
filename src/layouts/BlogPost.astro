---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getUrl } from '../utils/url';
import "../styles/callout.css"

interface Props extends CollectionEntry<'blog'>['data'] {}

const {
    title,
    subtitle,
    description = '',
    created_date,
    updated_date,
    featured_image,
    featured_image_alt,
    tags = [],
    meta_title,
    meta_description,
    canonical_url,
    og_title,
    og_description,
    og_image,
    og_type,
    twitter_title,
    twitter_description,
    twitter_image,
    twitter_card,
    keywords,
    author,
    no_index,
} = Astro.props;

const safeTags = tags ?? [];
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			featured_image={featured_image}
			featured_image_alt={featured_image_alt}
			meta_title={meta_title}
			meta_description={meta_description}
			canonical_url={canonical_url}
			og_title={og_title}
			og_description={og_description}
			og_image={og_image}
			og_type={og_type}
			twitter_title={twitter_title}
			twitter_description={twitter_description}
			twitter_image={twitter_image}
			twitter_card={twitter_card}
			keywords={[...safeTags, ...(keywords || [])]}
			author={author}
			no_index={no_index}
		/>
		
		<!-- KaTeX CSS for LaTeX rendering -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.css">

		<style>
			/*
			  Paper-reading redesign — Flexoki hairline-editorial (see DESIGN.md).
			  The article is one framed "sheet" lifted off the warm desk: hairline
			  border, whisper shadow, a manuscript margin rule, a masthead, and a
			  comfortable measure. Radius 0; colours from tokens only; CJK body
			  content set in Iansui via --font-cjk (defined in global.css).
			*/
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 2.5rem 1em 4.5rem;
			}

			/* The sheet: a page of paper on the desk */
			.prose {
				position: relative;
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3.75rem 4rem;
				background: rgb(var(--card-bg));
				border: 1px solid rgba(var(--black), 0.1);
				box-shadow: var(--box-shadow); /* whisper lift, sanctioned by DESIGN.md */
				color: rgb(var(--gray-dark));
				/* Iansui leads so Han glyphs resolve to it before any system
				   CJK face; Latin falls through to Onest / system stack */
				font-family: var(--font-cjk), var(--font-body);
				letter-spacing: 0.05em;
			}

			/* Manuscript margin rule down the left gutter — a reading guide */
			.prose::before {
				content: "";
				position: absolute;
				top: 3.75rem;
				bottom: 3.75rem;
				left: 2.5rem;
				width: 1px;
				background: rgba(var(--black), 0.1);
				pointer-events: none;
			}

			.hero-image {
				width: 100%;
				margin-top: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 0;
				border: 1px solid rgba(var(--black), 0.1);
			}

			/* Masthead: centered serif title closed by a hairline rule */
			.title {
				margin-bottom: 2.75rem;
				padding-bottom: 2rem;
				text-align: center;
				border-bottom: 1px solid rgba(var(--black), 0.1);
				font-family: var(--font-body);
			}

			.title h1 {
				margin: 0;
				/* Latin → Georgia, Han glyphs fall through to Iansui (per-glyph
				   fallback). No lang switching — the browser picks per char. */
				/* Iansui sits before serif generic; see DESIGN.md line 168 */
				font-family: Georgia, 'Times New Roman', 'Iansui', 'Iansui-Regular', serif;
				letter-spacing: -0.02em;
			}

			.subtitle {
				/* Iansui sits before serif generic; see DESIGN.md line 168 */
				font-family: Georgia, 'Times New Roman', 'Iansui', 'Iansui-Regular', serif;
				font-style: italic;
				color: rgb(var(--gray));
				font-size: 1.35rem;
				line-height: 1.4;
				margin: 0.85rem 0 0;
			}
			.date {
				font-family: var(--font-mono);
				font-size: 1.0rem;
				text-transform: uppercase;
				letter-spacing: 0.09em;
				color: rgb(var(--gray));
				margin-bottom: 1.1rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 1.6rem 0 0;
				justify-content: center;
			}
			/* Hairline accent badges — mirrors BlogCard.astro tag-badge */
			.tag {
				display: inline-flex;
				padding: 0.3rem 0.8rem;
				border: 1px solid rgba(var(--accent-rgb), 0.35);
				color: var(--accent);
				background: transparent;
				border-radius: 0;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				letter-spacing: 0.02em;
				text-decoration: none;
				transition: background-color 0.2s ease, color 0.2s ease;
			}
			.tag:hover {
				background: var(--accent);
				color: rgb(var(--gray-light));
			}

			/* End-of-article colophon mark */
			:global(.article-end) {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				margin: 3.5rem 0 0.5rem;
			}
			:global(.article-end::before),
			:global(.article-end::after) {
				content: "";
				width: 3rem;
				height: 1px;
				background: rgba(var(--black), 0.15);
			}
			:global(.article-end span) {
				width: 7px;
				height: 7px;
				background: var(--accent);
				display: block;
			}

			:global(.mermaid) {
				background: rgb(var(--gray-light));
				padding: 1.5rem;
				border: 1px solid rgba(var(--black), 0.1);
				border-radius: 0;
				margin: 2rem 0;
			}

			/* Image styling in prose */
			:global(.prose img) {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 1.5em auto;
				border-radius: 0;
			}
			:global(.yt-embed) {
				width: 100%;
				max-width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
			}

			:global(.yt-embed iframe) {
				width: 100% !important;
				height: 100% !important;
				max-width: 100%;
				border: 0;
			}
			:global(.prose iframe) {
				max-width: 100%;
			}

			/* Table of Contents Styles */
			.toc-wrapper {
				position: fixed;
				top: 6rem;
				right: 2rem;
				width: auto;
				max-width: 220px;
				max-height: calc(100vh - 8rem);
				overflow-y: auto;
				padding: 1rem 1.2rem;
				/* Flat hairline paper card — no blur/shadow, matches BlogCard */
				background: rgb(var(--card-bg));
				border-radius: 0;
				border: 1px solid rgba(var(--black), 0.1);
				z-index: 100;
				transition: border-color 0.2s ease;
			}
			.toc-wrapper.minimized {
				width: auto;
				padding: 0.8rem;
				overflow: hidden;
			}
			.toc-wrapper.minimized .toc-content {
				display: none;
			}
			.toc-wrapper.minimized .toc-header {
				border-bottom: none;
				margin-bottom: 0;
			}
			.toc-wrapper::-webkit-scrollbar {
				width: 6px;
			}
			.toc-wrapper::-webkit-scrollbar-track {
				background: transparent;
			}
			.toc-wrapper::-webkit-scrollbar-thumb {
				background: rgba(var(--accent-rgb), 0.3);
				border-radius: 0;
			}
			.toc-wrapper::-webkit-scrollbar-thumb:hover {
				background: rgba(var(--accent-rgb), 0.5);
			}
			.toc-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.8rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgba(var(--black), 0.1);
			}
			.toc-title {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}
			.toc-label {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.toc-minimize-btn {
				background: none;
				border: none;
				color: rgb(var(--gray));
				cursor: pointer;
				padding: 0.2rem 0.4rem;
				font-size: 1.1em;
				font-weight: 600;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 0;
				transition: all 0.2s ease;
				line-height: 1;
			}
			.toc-minimize-btn:hover {
				background: rgba(var(--gray), 0.1);
				color: rgb(var(--accent));
			}
			.toc-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			:global(.toc-list li) {
				margin: 0;
				position: relative;
				list-style: none;
			}
			:global(.toc-list ul) {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			:global(.toc-list .toc-item) {
				display: flex;
				align-items: center;
			}
			:global(.toc-list .toc-toggle) {
				background: none;
				border: none;
				color: rgb(var(--gray));
				cursor: pointer;
				padding: 0.2rem;
				margin-right: 0.3rem;
				font-size: 0.7em;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 16px;
				height: 16px;
				border-radius: 0;
				transition: all 0.2s ease;
				flex-shrink: 0;
			}
			:global(.toc-list .toc-toggle:hover) {
				background: rgba(var(--gray), 0.1);
			}
			:global(.toc-list .toc-toggle.collapsed) {
				transform: rotate(-90deg);
			}
			:global(.toc-list a) {
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				transition: all 0.2s ease;
				display: block;
				padding: 0.3rem 0.5rem;
				flex: 1;
				border-radius: 0;
			}
			:global(.toc-list a:hover) {
				color: rgb(var(--accent));
				background: rgba(var(--gray), 0.1);
			}
			:global(.toc-list a.active) {
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.12);
				font-weight: 500;
				border: 1px solid rgba(var(--accent-rgb), 0.3);
			}
			
			/* toc css */
			:global(.toc-list .toc-h1) {
				font-size: 0.9em;
				font-weight: 600;
			}
			:global(.toc-list .toc-h1-item) {
				padding-left: 0;
			}
			
			:global(.toc-list .toc-h2) {
				font-size: 0.87em;
			}
			:global(.toc-list .toc-h2-item) {
				padding-left: 1rem;
			}
			
			:global(.toc-list .toc-h3) {
				font-size: 0.84em;
			}
			:global(.toc-list .toc-h3-item) {
				padding-left: 1rem;
			}
			
			:global(.toc-list .toc-h4) {
				font-size: 0.81em;
			}
			:global(.toc-list .toc-h4-item) {
				padding-left: 2rem;
			}
			
			:global(.toc-list .toc-h5) {
				font-size: 0.78em;
			}
			:global(.toc-list .toc-h5-item) {
				padding-left: 3rem;
			}
			
			:global(.toc-list .toc-children) {
				display: block;
			}
			:global(.toc-list .toc-children.collapsed) {
				display: none;
			}

			/* Reader zoom — scales content uniformly (text, headings, code)
			   without touching the sheet's frame width. Root font-size on
			   `.prose` scales, and all descendants inherit via em/inherit.
			   Images fit the frame (max-width: 100%) so they stay in-bounds. */
			.prose {
				font-size: calc(1.0625rem * var(--reader-scale, 1));
			}

			/* Reader toolbox — flat hairline card, bottom-right */
			.reader-tools {
				position: fixed;
				right: 2rem;
				bottom: 2rem;
				z-index: 200;
				display: flex;
				align-items: stretch;
				background: rgb(var(--card-bg));
				border: 1px solid rgba(var(--black), 0.1);
				box-shadow: var(--box-shadow);
			}
			.reader-tools button {
				background: none;
				border: none;
				cursor: pointer;
				color: rgb(var(--gray-dark));
				line-height: 1;
				transition: color 0.2s ease, background-color 0.2s ease;
			}
			.rt-btn {
				font-family: var(--font-heading);
				padding: 0.4rem 0.7rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.rt-minus { font-size: 0.85rem; }
			.rt-plus { font-size: 1.3rem; }
			.rt-label {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: rgb(var(--gray));
				min-width: 3.4ch;
				padding: 0 0.2rem;
				border-left: 1px solid rgba(var(--black), 0.1) !important;
				border-right: 1px solid rgba(var(--black), 0.1) !important;
			}
			.reader-tools button:hover {
				color: var(--accent);
				background: rgba(var(--gray), 0.12);
			}

			/* Mobile: Show TOC at top */
			@media (max-width: 1024px) {
				.toc-wrapper {
					position: relative;
					top: 0;
					right: 0;
					width: 100%;
					max-width: 100%;
					margin: 0 0 2rem 0;
					max-height: none;
				}
			}

			/* Hide TOC on very small screens */
			@media (max-width: 640px) {
				.toc-wrapper {
					display: none;
				}
			}

			/* Narrow screens: tighten the sheet margins, drop the manuscript rule */
			@media (max-width: 720px) {
				main {
					padding: 1.25rem 0.75em 3rem;
				}
				.prose {
					padding: 2rem 1.5rem;
				}
				.prose::before {
					display: none;
				}
				.title {
					margin-bottom: 2rem;
					padding-bottom: 1.5rem;
				}
				.reader-tools {
					right: 1rem;
					bottom: 1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
							{created_date && (
								<div class="date">
									<FormattedDate date={created_date} />
									{updated_date && updated_date > created_date && (
										<span> (Updated: <FormattedDate date={updated_date} />)</span>
									)}
								</div>
							)}
							<h1>{title}</h1>
							{subtitle && <div class="subtitle">{subtitle}</div>}
							{safeTags.length > 0 && (
								<div class="tags">
									{safeTags.map((tag) => (
										<a href={getUrl(`/tag/${tag}/`)} class="tag">#{tag}</a>
									))}
								</div>
							)}
							{featured_image && (
								<div class="hero-image">
									<img
										width={1020}
										height={510}
										src={featured_image}
										alt={featured_image_alt || ''}
									/>
								</div>
							)}
					</div>
					
					<!-- Table of Contents -->
					<aside class="toc-wrapper" id="toc-wrapper">
						<div class="toc-header">
							<div class="toc-title">
								<span class="toc-label">Contents</span>
								<button class="toc-minimize-btn" id="toc-minimize-btn" aria-label="Toggle TOC">
									<span id="toc-icon">−</span>
								</button>
							</div>
						</div>
						<div class="toc-content">
							<ul class="toc-list" id="toc-list"></ul>
						</div>
					</aside>
					
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<!-- Reader toolbox: font-size zoom -->
		<div class="reader-tools" id="reader-tools" role="group" aria-label="Reading controls">
			<button type="button" class="rt-btn rt-minus" data-fs="-" aria-label="Decrease font size">A</button>
			<button type="button" class="rt-label" id="reader-fs-label" aria-label="Reset font size" title="Reset">100%</button>
			<button type="button" class="rt-btn rt-plus" data-fs="+" aria-label="Increase font size">A</button>
		</div>

		<script>
			import mermaid from 'mermaid';
			
			function processObsidianImageSizes() {
				const images = document.querySelectorAll('.prose img');
				images.forEach(img => {
					const imgElement = img as HTMLImageElement;
					const alt = imgElement.getAttribute('alt');
					if (alt) {
						// Check for Obsidian size syntax: "image.png|400"
						const match = alt.match(/^(.+?)\|(\d+)$/);
						if (match) {
							const [, actualAlt, width] = match;
							// Update alt text (remove size parameter)
							imgElement.setAttribute('alt', actualAlt);
							// Apply width styling
							imgElement.style.width = `${width}px`;
							imgElement.style.height = 'auto';
							imgElement.style.maxWidth = '100%';
						}
					}
				});
			}

			// Paper cue: end-of-article mark
			function decoratePaperArticle() {
				const prose = document.querySelector('.prose');
				if (!prose) return;

				// End mark — append once
				if (!prose.querySelector('.article-end')) {
					const end = document.createElement('div');
					end.className = 'article-end';
					end.setAttribute('aria-hidden', 'true');
					end.appendChild(document.createElement('span'));
					prose.appendChild(end);
				}
			}

			// Reader toolbox: font-size zoom, persisted across posts
			function setupReaderTools() {
				const tools = document.getElementById('reader-tools');
				const label = document.getElementById('reader-fs-label');
				const prose = document.querySelector('.prose') as HTMLElement | null;
				if (!tools || !label || !prose) return;

				const MIN = 0.85, MAX = 1.6, STEP = 0.1;
				let scale = parseFloat(localStorage.getItem('reader-scale') || '1');
				if (isNaN(scale)) scale = 1;

				const apply = () => {
					scale = Math.min(MAX, Math.max(MIN, scale));
					prose.style.setProperty('--reader-scale', String(scale));
					label.textContent = Math.round(scale * 100) + '%';
					localStorage.setItem('reader-scale', String(scale));
				};
				apply();

				if (tools.dataset.ready) return;
				tools.dataset.ready = '1';

				tools.querySelectorAll('.rt-btn').forEach(btn => {
					btn.addEventListener('click', () => {
						scale += (btn as HTMLElement).dataset.fs === '+' ? STEP : -STEP;
						scale = Math.round(scale * 100) / 100;
						apply();
					});
				});
				label.addEventListener('click', () => { scale = 1; apply(); });
			}

			function initTOC() {
				const article = document.querySelector('.prose');
				const tocList = document.getElementById('toc-list');
				
				if (article && tocList) {
					// exclude title
					const titleSection = article.querySelector('.title');
					const allHeadings = article.querySelectorAll('h1, h2, h3, h4, h5');
					const headings = Array.from(allHeadings).filter(heading => {
						return !titleSection || !titleSection.contains(heading);
					});
					
					tocList.innerHTML = '';
					
					if (headings.length === 0) {
						tocList.innerHTML = '<li style="color: rgb(var(--gray)); font-size: 0.9em;">無目錄項目</li>';
						return;
					}
					
					const stack = [{ level: 0, element: tocList }];
					
					headings.forEach((heading, index) => {
						const id = heading.id || `heading-${index}`;
						if (!heading.id) {
							heading.id = id;
						}
						
						const level = parseInt(heading.tagName.charAt(1));
						const text = heading.textContent;
						
						while (stack.length > 1 && stack[stack.length - 1].level >= level) {
							stack.pop();
						}
						
						const parent = stack[stack.length - 1];
						const parentElement = parent.children || parent.element;
						
						// create toc
						const li = document.createElement('li');
						li.className = `toc-h${level}-item`;
						
						const itemDiv = document.createElement('div');
						itemDiv.className = 'toc-item';
						
						// checking H1 H2 H3 --> for collapse-able
						let hasChildren = false;
						if (level <= 3) {
							const currentIndex = Array.from(headings).indexOf(heading);
							for (let i = currentIndex + 1; i < headings.length; i++) {
								const nextLevel = parseInt(headings[i].tagName.charAt(1));
								if (nextLevel <= level) break;
								if (nextLevel === level + 1) {
									hasChildren = true;
									break;
								}
							}
						}
						
						if (hasChildren) {
							const toggle = document.createElement('button');
							toggle.className = 'toc-toggle';
							toggle.innerHTML = '▼';
							toggle.setAttribute('aria-label', 'Toggle section');
							itemDiv.appendChild(toggle);
							
							// add child
							const childrenUl = document.createElement('ul');
							childrenUl.className = 'toc-children';
							li.appendChild(childrenUl);
							
							// Toggle
							toggle.addEventListener('click', (e) => {
								e.stopPropagation();
								toggle.classList.toggle('collapsed');
								childrenUl.classList.toggle('collapsed');
							});
							
							stack.push({ level, element: li, children: childrenUl });
						}
						
						// add link
						const a = document.createElement('a');
						a.href = `#${id}`;
						a.textContent = text;
						a.className = `toc-h${level}`;
						a.dataset.id = id;
						
						itemDiv.appendChild(a);
						li.insertBefore(itemDiv, li.firstChild);
						
						parentElement.appendChild(li);
					});

					// smooth scroll
					tocList.querySelectorAll('a').forEach(link => {
						link.addEventListener('click', (e) => {
							e.preventDefault();
							const id = link.dataset.id;
							const target = document.getElementById(id);
							if (target) {
								const offset = 100;
								const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
								window.scrollTo({
									top: targetPosition,
									behavior: 'smooth'
								});
								history.pushState(null, null, `#${id}`);
							}
						});
					});

					// Active state on scroll
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							const id = entry.target.id;
							const tocLink = tocList.querySelector(`a[data-id="${id}"]`);
							
							if (entry.isIntersecting) {
								tocList.querySelectorAll('a').forEach(link => link.classList.remove('active'));
								if (tocLink) {
									tocLink.classList.add('active');
									// auto extend
									let parentUl = tocLink.closest('li').parentElement;
									while (parentUl && parentUl.classList.contains('toc-children')) {
										parentUl.classList.remove('collapsed');
										const parentLi = parentUl.closest('li');
										if (parentLi) {
											const toggle = parentLi.querySelector('.toc-toggle');
											if (toggle) toggle.classList.remove('collapsed');
											parentUl = parentLi.parentElement;
										} else {
											break;
										}
									}
								}
							}
						});
					}, {
						rootMargin: '-20% 0px -70% 0px'
					});

					headings.forEach(heading => observer.observe(heading));
				}
			}

			// Initialize on Astro page load
			document.addEventListener('astro:page-load', () => {
				mermaid.initialize({
					startOnLoad: true,
					theme: 'default'
				});
				processObsidianImageSizes();
				initTOC();
				decoratePaperArticle();
				setupReaderTools();

				// TOC minimize functionality
				const tocWrapper = document.getElementById('toc-wrapper');
				const minimizeBtn = document.getElementById('toc-minimize-btn');
				const tocIcon = document.getElementById('toc-icon');
				
				if (minimizeBtn && tocWrapper && tocIcon) {
					minimizeBtn.addEventListener('click', () => {
						tocWrapper.classList.toggle('minimized');
						tocIcon.textContent = tocWrapper.classList.contains('minimized') ? '+' : '−';
					});
				}
			});

			// Also initialize on DOMContentLoaded as fallback
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					processObsidianImageSizes();
					initTOC();
					decoratePaperArticle();
					setupReaderTools();

					const tocWrapper = document.getElementById('toc-wrapper');
					const minimizeBtn = document.getElementById('toc-minimize-btn');
					const tocIcon = document.getElementById('toc-icon');

					if (minimizeBtn && tocWrapper && tocIcon) {
						minimizeBtn.addEventListener('click', () => {
							tocWrapper.classList.toggle('minimized');
							tocIcon.textContent = tocWrapper.classList.contains('minimized') ? '+' : '−';
						});
					}
				});
			} else {
				processObsidianImageSizes();
				initTOC();
				decoratePaperArticle();
				setupReaderTools();

				const tocWrapper = document.getElementById('toc-wrapper');
				const minimizeBtn = document.getElementById('toc-minimize-btn');
				const tocIcon = document.getElementById('toc-icon');
				
				if (minimizeBtn && tocWrapper && tocIcon) {
					minimizeBtn.addEventListener('click', () => {
						tocWrapper.classList.toggle('minimized');
						tocIcon.textContent = tocWrapper.classList.contains('minimized') ? '+' : '−';
					});
				}
			}
		</script>
	</body>
</html>