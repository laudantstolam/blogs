---
import FormattedDate from './FormattedDate.astro';
import { getUrl } from '../utils/url';

interface Props {
    title: string;
    description?: string;
    date?: Date;
    slug: string;
    tags?: string[];
    compact?: boolean;
}

const { title, description, date, slug, tags = [], compact = false } = Astro.props;

// Generate a consistent post ID for graph sync
const postId = slug.replace(/\//g, '-');

// Format date as YYYY/MM for compact view
function formatShortDate(d: Date): string {
    const year = d.getFullYear();
    const month = (d.getMonth() + 1).toString().padStart(2, '0');
    return `${year}/${month}`;
}
---

<article class:list={["blog-card", { compact }]} data-tags={tags.join(',').toLowerCase()} data-post-id={postId}>
    <a href={getUrl(`/${slug}/`)} class="card-link">
        <div class="card-content">
            {compact ? (
                <!-- Compact: [date title tags] with description below -->
                <>
                    {date && (
                        <time class="date">
                            {formatShortDate(date)}
                        </time>
                    )}
                    <div class="main-content">
                        <h2 class="title">{title}</h2>
                        {description && <p class="description">{description}</p>}
                    </div>
                    {tags.length > 0 && (
                        <div class="tags-inline">
                            {tags.slice(0, 2).map(tag => (
                                <span class="tag-badge">{tag}</span>
                            ))}
                            {tags.length > 2 && <span class="tag-more">+{tags.length - 2}</span>}
                        </div>
                    )}
                </>
            ) : (
                <!-- Full card view -->
                <>
                    <div class="main-content">
                        <h2 class="title">{title}</h2>
                        {description && <p class="description">{description}</p>}
                    </div>
                    <div class="footer">
                        {date && (
                            <time class="date">
                                <FormattedDate date={date} />
                            </time>
                        )}
                        <div class="read-more">
                            Read More
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M5 12h14m-7-7 7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </>
            )}
        </div>
    </a>
</article>

<style>
    .blog-card {
        position: relative;
        border-radius: 20px;
        background: rgb(var(--card-bg));
        box-shadow: 
            0 4px 6px -1px rgba(0, 0, 0, 0.05),
            0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    @media (prefers-color-scheme: dark) {
        .blog-card {
            background: rgb(var(--card-bg));
        }
    }

    .blog-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            160deg,
            rgba(var(--accent), 0.02) 0%,
            rgba(var(--accent), 0.04) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .blog-card:hover {
        transform: translateY(-4px);
        box-shadow: 
            0 20px 25px -5px rgba(0, 0, 0, 0.1),
            0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .blog-card:hover::after {
        opacity: 1;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .card-content {
        position: relative;
        z-index: 1;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        height: 100%;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .main-content p{
        margin-bottom: 0.25em;
        margin-top: 0rem
    }

    .title {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
        margin-top: 0.5rem;
        color: rgb(var(--black));
        transition: color 0.2s ease;
    }

    .blog-card:hover .title {
        color: rgb(var(--accent));
    }

    .description {
        color: rgb(var(--gray));
        line-height: 1.6;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
    }

    .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--black), 0.06);
    }

    .date {
        font-size: 0.875rem;
        color: rgb(var(--gray));
    }

    .read-more {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgb(var(--accent));
        transition: gap 0.3s ease;
    }

    .read-more svg {
        transition: transform 0.3s ease;
    }

    .blog-card:hover .read-more {
        gap: 0.75rem;
    }

    .blog-card:hover .read-more svg {
        transform: translateX(4px);
    }

    /* ==================== COMPACT VIEW ==================== */
    .blog-card.compact {
        border-radius: 12px;
    }

    .blog-card.compact .card-content {
        flex-direction: row;
        align-items: center;
        padding: 0.75rem 1rem;
        gap: 0.75rem;
    }

    .blog-card.compact .date {
        font-size: 0.8rem;
        font-family: 'SF Mono', 'Fira Code', monospace;
        color: rgb(var(--gray));
        opacity: 0.7;
        flex-shrink: 0;
        min-width: 65px;
    }

    .blog-card.compact .main-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0;
    }

    .blog-card.compact .title {
        font-size: 0.95rem;
        margin-top: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card.compact .description {
        font-size: 0.8rem;
        color: rgb(var(--gray));
        margin-top: 0.25rem;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 1;
        overflow: hidden;
        line-height: 1.4;
    }

    /* Tags inline for compact view */
    .tags-inline {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .tag-badge {
        display: inline-flex;
        padding: 0.2rem 0.5rem;
        background: rgba(var(--accent), 0.1);
        color: var(--accent);
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .tag-more {
        font-size: 0.7rem;
        color: rgb(var(--gray));
        opacity: 0.7;
    }

    .blog-card.compact:hover .tag-badge {
        background: rgba(var(--accent), 0.15);
    }

    @media (max-width: 768px) {
        .blog-card {
            border-radius: 16px;
        }

        .card-content {
            padding: 1.25rem;
            gap: 1rem;
        }

        .title {
            font-size: 1.25rem;
        }

        .footer {
            padding-top: 0.875rem;
        }

        .blog-card.compact .card-content {
            flex-wrap: wrap;
        }

        .blog-card.compact .date {
            min-width: auto;
        }

        .blog-card.compact .main-content {
            flex-basis: calc(100% - 80px);
        }

        .blog-card.compact .title {
            white-space: normal;
        }

        .blog-card.compact .description {
            -webkit-line-clamp: 2;
        }

        .blog-card.compact .tags-inline {
            flex-basis: 100%;
            margin-top: 0.25rem;
        }
    }
</style> 