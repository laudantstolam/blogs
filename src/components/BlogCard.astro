---
import FormattedDate from './FormattedDate.astro';
import { getUrl } from '../utils/url';

interface Props {
    title: string;
    description?: string;
    date?: Date;
    slug: string;
    tags?: string[];
    timeline?: boolean;
}

const { title, description, date, slug, tags = [], timeline = false } = Astro.props;

// Generate a consistent post ID for graph sync
const postId = slug.replace(/\//g, '-');
---

<article class:list={["blog-card", { timeline }]} data-tags={tags.join(',').toLowerCase()} data-post-id={postId}>
    <a href={getUrl(`/${slug}/`)} class="card-link">
        <div class="card-content">
            {timeline ? (
                <!-- Timeline: dot-marker feed row, tags pinned to the right -->
                <>
                    <div class="timeline-main">
                        {date && (
                            <time class="date">
                                <FormattedDate date={date} />
                            </time>
                        )}
                        <h2 class="title">{title}</h2>
                        {description && <p class="description">{description}</p>}
                    </div>
                    {tags.length > 0 && (
                        <div class="tags-inline">
                            {tags.map(tag => (
                                <span class="tag-badge">{tag}</span>
                            ))}
                        </div>
                    )}
                </>
            ) : (
                <!-- Full card view -->
                <>
                    <div class="main-content">
                        <h2 class="title">{title}</h2>
                        {description && <p class="description">{description}</p>}
                    </div>
                    <div class="footer">
                        {date && (
                            <time class="date">
                                <FormattedDate date={date} />
                            </time>
                        )}
                        <div class="read-more">
                            Read More
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M5 12h14m-7-7 7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </>
            )}
        </div>
    </a>
</article>

<style>
    /* Editorial / hairline language per DESIGN.md: no radius, no drop shadow, flat borders */
    .blog-card {
        position: relative;
        background: rgb(var(--card-bg));
        border: 1px solid rgba(var(--black), 0.1);
        transition: border-color 0.2s ease, background-color 0.25s ease;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .card-content {
        position: relative;
        z-index: 1;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        height: 100%;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .main-content p{
        margin-bottom: 0.25em;
        margin-top: 0rem
    }

    .title {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.25;
        margin-top: 0.5rem;
        color: rgb(var(--black));
        font-family: var(--font-heading);
        transition: color 0.2s ease;
    }

    .blog-card:hover {
        border-color: var(--accent);
    }

    .blog-card:hover .title {
        color: var(--accent);
    }

    .description {
        color: rgb(var(--gray));
        line-height: 1.6;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
    }

    .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--black), 0.08);
    }

    .date {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: rgb(var(--gray));
    }

    .read-more {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent);
        transition: gap 0.2s ease;
    }

    .read-more svg {
        transition: transform 0.2s ease;
    }

    .blog-card:hover .read-more {
        gap: 0.65rem;
    }

    .blog-card:hover .read-more svg {
        transform: translateX(3px);
    }

    .tags-inline {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag-badge {
        display: inline-flex;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(var(--accent-rgb), 0.35);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    /* ==================== TIMELINE VARIANT: dot-marker feed row ==================== */
    .blog-card.timeline {
        border: none;
        border-bottom: 1px solid rgba(var(--black), 0.1);
        background: transparent;
        border-radius: 0;
    }

    .blog-card.timeline:last-child {
        border-bottom: none;
    }

    .blog-card.timeline::before {
        content: "";
        position: absolute;
        left: -5px;
        top: 1.85rem;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: rgb(var(--card-bg));
        border: 2px solid rgba(var(--black), 0.3);
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .blog-card.timeline:hover::before {
        border-color: var(--accent);
        background: var(--accent);
    }

    .blog-card.timeline .card-content {
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        padding: 1.5rem 0 1.5rem 2rem;
        gap: 1.25rem;
    }

    .blog-card.timeline .timeline-main {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        min-width: 0;
        flex: 1;
    }

    .blog-card.timeline .tags-inline {
        flex-shrink: 0;
        justify-content: flex-end;
        padding-top: 0.2rem;
        max-width: 40%;
    }

    .blog-card.timeline .date {
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .blog-card.timeline .title {
        font-size: 1.35rem;
        margin-top: 0.3rem;
    }

    .blog-card.timeline .description {
        font-size: 0.92rem;
        -webkit-line-clamp: 2;
        margin-bottom: 0.2rem;
    }

    @media (max-width: 768px) {
        .card-content {
            padding: 1rem;
            gap: 0.75rem;
        }

        .title {
            font-size: 1.2rem;
        }

        .footer {
            padding-top: 0.875rem;
        }

        .blog-card.timeline .card-content {
            flex-direction: column;
            align-items: stretch;
            padding: 1.25rem 0 1.25rem 1.5rem;
        }

        .blog-card.timeline .tags-inline {
            justify-content: flex-start;
            max-width: none;
        }

        .blog-card.timeline .title {
            font-size: 1.15rem;
        }
    }
</style>
