---
import { getCollection } from 'astro:content';
import { getUrl } from '../utils/url';

interface Props {
  height?: string;
  showControls?: boolean;
}

const { height = '500px', showControls = true } = Astro.props;

const allPosts = await getCollection('blog');

// Build nodes and edges
const nodes: Array<{data: {id: string, label: string, type: string, url?: string, count?: number, slugId?: string}}> = [];
const edges: Array<{data: {source: string, target: string}}> = [];
const tagNodes = new Map<string, number>();

// Count tag occurrences
allPosts.forEach((post) => {
  const tags = post.data.tags || [];
  tags.forEach(tag => {
    tagNodes.set(tag, (tagNodes.get(tag) || 0) + 1);
  });
});

// Create tag nodes
tagNodes.forEach((count, tag) => {
  nodes.push({
    data: { id: `tag-${tag}`, label: tag, type: 'tag', count }
  });
});

// Create post nodes and edges
allPosts.forEach((post) => {
  const postNodeId = `post-${post.id}`;
  const slug = post.data.slug || post.id;
  const slugId = slug.replace(/\//g, '-');

  nodes.push({
    data: {
      id: postNodeId,
      label: post.data.title,
      type: 'post',
      url: getUrl(`/${slug}`),
      slugId: slugId  // Store slug-based ID for matching with BlogCard
    }
  });

  const tags = post.data.tags || [];
  tags.forEach(tag => {
    edges.push({ data: { source: `tag-${tag}`, target: postNodeId } });
  });
});

// Build tag co-occurrence
const tagCooccurrence = new Map<string, number>();
allPosts.forEach((post) => {
  const tags = post.data.tags || [];
  for (let i = 0; i < tags.length; i++) {
    for (let j = i + 1; j < tags.length; j++) {
      const key = [tags[i], tags[j]].sort().join('--');
      tagCooccurrence.set(key, (tagCooccurrence.get(key) || 0) + 1);
    }
  }
});

// Convert to tag-tag edges
const tagEdges: Array<{data: {source: string, target: string, weight: number}}> = [];
tagCooccurrence.forEach((weight, key) => {
  const [tag1, tag2] = key.split('--');
  tagEdges.push({
    data: { source: `tag-${tag1}`, target: `tag-${tag2}`, weight }
  });
});

const graphId = `graph-${Math.random().toString(36).substr(2, 9)}`;
---

<div class:list={["graph-container", { "compact-mode": !showControls }]} style={`height: ${height};`} role="img" aria-label="Interactive knowledge graph showing connections between blog posts and tags">
  {showControls && (
    <div class="graph-controls" role="toolbar" aria-label="Graph controls">
      <button class="graph-btn active" data-action="all" aria-pressed="true" aria-label="Show all nodes">All</button>
      <button class="graph-btn" data-action="tags" aria-pressed="false" aria-label="Show tags only">Tags Only</button>
      <button class="graph-btn" data-action="reset" aria-label="Reset view">Reset</button>
    </div>
  )}

  {showControls && (
    <div class="graph-legend">
      <div class="legend-item">
        <div class="legend-dot tag"></div>
        <span>Tag</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot post"></div>
        <span>Post</span>
      </div>
      <div class="legend-item">
        <div class="legend-line"></div>
        <span>Related</span>
      </div>
    </div>
  )}

  <div class="graph-canvas" id={graphId}></div>

  {showControls && (
    <div class="graph-hint">
      Click tag to highlight • Click post to open • Drag to pan • Scroll to zoom
    </div>
  )}
</div>

<style>
  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  .graph-container {
    position: relative;
    width: 100%;
    border-radius: 0;
    overflow: hidden;
    background: rgb(var(--card-bg));
    border: 1px solid rgba(var(--gray), 0.15);
  }

  .graph-canvas {
    width: 100%;
    height: 100%;
    min-height: 200px;
  }

  .graph-container.compact-mode {
    border: none;
    border-radius: 0;
  }

  .graph-container.compact-mode .graph-canvas {
    min-height: 250px;
  }

  .graph-controls {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .graph-btn {
    min-height: 36px;
    padding: 8px 14px;
    border: 1px solid rgba(var(--gray), 0.2);
    border-radius: 0;
    background: rgb(var(--card-bg));
    color: rgb(var(--gray-dark));
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .graph-btn:hover {
    background: rgba(var(--gray), 0.1);
    border-color: var(--accent);
    color: var(--accent);
  }

  .graph-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .graph-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .graph-legend {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    padding: 10px 14px;
    background: rgb(var(--card-bg));
    border-radius: 0;
    font-size: 12px;
    border: 1px solid rgba(var(--gray), 0.15);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .legend-item:last-child {
    margin-bottom: 0;
  }

  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .legend-dot.tag { background: var(--accent); }
  .legend-dot.post { background: rgb(var(--gray)); }

  .legend-line {
    width: 20px;
    height: 2px;
    background: linear-gradient(90deg, #ec4899, transparent);
    border-radius: 1px;
  }

  .graph-hint {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 10;
    padding: 8px 12px;
    background: rgb(var(--card-bg));
    color: rgb(var(--gray-dark));
    border-radius: 0;
    font-size: 11px;
    text-align: center;
    border: 1px solid rgba(var(--gray), 0.15);
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .graph-controls {
      top: 8px;
      left: 8px;
    }

    .graph-btn {
      padding: 6px 10px;
      font-size: 11px;
    }

    .graph-legend {
      top: 8px;
      right: 8px;
      padding: 8px 10px;
      font-size: 11px;
    }

    .graph-hint {
      bottom: 8px;
      left: 8px;
      right: 8px;
      font-size: 10px;
      padding: 6px 10px;
    }
  }
</style>

<script src="https://unpkg.com/cytoscape@3.28.1/dist/cytoscape.min.js" is:inline></script>
<script src="https://unpkg.com/webcola@3.4.0/WebCola/cola.min.js" is:inline></script>
<script src="https://unpkg.com/cytoscape-cola@2.5.1/cytoscape-cola.js" is:inline></script>

<script is:inline define:vars={{ nodes, edges, tagEdges, graphId }}>
  // Wait for DOM and libraries to load
  function initGraph() {
    if (typeof cytoscape === 'undefined' || typeof cytoscapeCola === 'undefined') {
      setTimeout(initGraph, 100);
      return;
    }

    const container = document.getElementById(graphId);
    if (!container) return;

    // Theme colors
    const colors = {
      light: {
        tag: '#205ea6',
        tagText: '#ffffff',
        post: '#6073a0',
        postText: '#22293a',
        edge: '#9ca3af',
        cooccur: '#ec4899',
        highlight: '#10b981'
      },
      dark: {
        tag: '#205ea6',
        tagText: '#ffffff',
        post: '#64748b',
        postText: '#e2e8f0',
        edge: '#4b5563',
        cooccur: '#ec4899',
        highlight: '#10b981'
      }
    };

    function getTheme() {
      return document.documentElement.getAttribute('data-theme') || 'dark';
    }

    function getColors() {
      return colors[getTheme()] || colors.dark;
    }

    // Register cola layout
    if (typeof cytoscapeCola !== 'undefined') {
      cytoscape.use(cytoscapeCola);
    }

    const cy = cytoscape({
      container: container,
      elements: {
        nodes: nodes,
        edges: [...edges, ...tagEdges]
      },
      style: [],
      layout: { name: 'preset' },
      minZoom: 0.3,
      maxZoom: 2.5,
      wheelSensitivity: 0.3,
    });

    // Layout options
    const layoutOptions = {
      name: 'cola',
      animate: true,
      refresh: 1,
      maxSimulationTime: 4000,
      ungrabifyWhileSimulating: false,
      fit: true,
      padding: 30,
      nodeDimensionsIncludeLabels: false,
      edgeLength: function(edge) {
        return edge.data('weight') ? 80 : 120;
      },
      nodeSpacing: 25,
      randomize: true,
      handleDisconnected: true,
      convergenceThreshold: 0.001,
      infinite: false,
    };

    function runLayout() {
      cy.layout(layoutOptions).run();
    }

    runLayout();

    function updateGraphColors() {
      const c = getColors();

      cy.style()
        .selector('node[type="tag"]')
        .style({
          'background-color': c.tag,
          'label': 'data(label)',
          'width': 'mapData(count, 1, 10, 30, 60)',
          'height': 'mapData(count, 1, 10, 30, 60)',
          'text-valign': 'center',
          'text-halign': 'center',
          'color': c.tagText,
          'font-weight': 'bold',
          'font-size': 10,
          'text-outline-color': c.tag,
          'text-outline-width': 2,
          'z-index': 10,
          'transition-property': 'width, height, background-color, opacity',
          'transition-duration': '0.2s',
        })
        .selector('node[type="post"]')
        .style({
          'background-color': c.post,
          'label': 'data(label)',
          'width': 22,
          'height': 22,
          'text-valign': 'bottom',
          'text-halign': 'center',
          'color': c.postText,
          'font-size': 8,
          'text-wrap': 'ellipsis',
          'text-max-width': 80,
          'text-margin-y': 4,
          'opacity': 0.8,
          'transition-property': 'width, height, background-color, opacity',
          'transition-duration': '0.2s',
        })
        .selector('edge[weight]')
        .style({
          'width': 'mapData(weight, 1, 5, 1, 3)',
          'line-color': c.cooccur,
          'line-opacity': 0.3,
          'curve-style': 'bezier',
        })
        .selector('edge:not([weight])')
        .style({
          'width': 1,
          'line-color': c.edge,
          'line-opacity': 0.4,
          'curve-style': 'bezier',
        })
        .selector('node.hover')
        .style({
          'width': function(ele) {
            const base = ele.data('type') === 'tag' ?
              Math.min(30 + (ele.data('count') || 1) * 3, 60) : 22;
            return base * 1.25;
          },
          'height': function(ele) {
            const base = ele.data('type') === 'tag' ?
              Math.min(30 + (ele.data('count') || 1) * 3, 60) : 22;
            return base * 1.25;
          },
          'z-index': 100,
        })
        .selector('node.dimmed')
        .style({ 'opacity': 0.2 })
        .selector('edge.dimmed')
        .style({ 'line-opacity': 0.1 })
        .selector('.highlighted')
        .style({
          'background-color': c.highlight,
          'text-outline-color': c.highlight,
          'opacity': 1,
          'z-index': 20,
        })
        .selector('.faded')
        .style({ 'opacity': 0.15 })
        .selector('.hidden')
        .style({ 'display': 'none' })
        .update();
    }

    updateGraphColors();

    // Hover effects
    let hoverTimeout = null;

    cy.on('mouseover', 'node', function(evt) {
      if (hoverTimeout) clearTimeout(hoverTimeout);

      const node = evt.target;
      const connected = node.connectedEdges().connectedNodes();
      const connectedEdges = node.connectedEdges();

      cy.elements().removeClass('hover hover-connected dimmed');
      node.addClass('hover');
      connected.addClass('hover-connected');
      connectedEdges.addClass('hover-connected');
      cy.elements().not(node).not(connected).not(connectedEdges).addClass('dimmed');
    });

    cy.on('mouseout', 'node', function() {
      hoverTimeout = setTimeout(() => {
        cy.elements().removeClass('hover hover-connected dimmed');
      }, 100);
    });

    // Click post to open
    cy.on('tap', 'node[type="post"]', function(evt) {
      const url = evt.target.data('url');
      if (url) {
        window.location.href = url;
      }
    });

    // Click tag to highlight
    cy.on('tap', 'node[type="tag"]', function(evt) {
      const node = evt.target;
      const connected = node.connectedEdges().connectedNodes();

      cy.elements().removeClass('highlighted faded hover hover-connected dimmed');
      cy.elements().addClass('faded');
      node.removeClass('faded').addClass('highlighted');
      connected.removeClass('faded').addClass('highlighted');
      node.connectedEdges().removeClass('faded');
    });

    // Click background to reset
    cy.on('tap', function(evt) {
      if (evt.target === cy) {
        cy.elements().removeClass('highlighted faded hover hover-connected dimmed');
      }
    });

    // Button controls with accessibility
    const graphContainer = container.closest('.graph-container');
    if (graphContainer) {
      const allBtn = graphContainer.querySelector('[data-action="all"]');
      const tagsBtn = graphContainer.querySelector('[data-action="tags"]');

      graphContainer.querySelectorAll('.graph-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const action = this.getAttribute('data-action');

          if (action === 'all') {
            cy.nodes('[type="post"]').removeClass('hidden');
            cy.edges(':not([weight])').removeClass('hidden');
            if (allBtn) {
              allBtn.classList.add('active');
              allBtn.setAttribute('aria-pressed', 'true');
            }
            if (tagsBtn) {
              tagsBtn.classList.remove('active');
              tagsBtn.setAttribute('aria-pressed', 'false');
            }
            runLayout();
          } else if (action === 'tags') {
            cy.nodes('[type="post"]').addClass('hidden');
            cy.edges(':not([weight])').addClass('hidden');
            if (tagsBtn) {
              tagsBtn.classList.add('active');
              tagsBtn.setAttribute('aria-pressed', 'true');
            }
            if (allBtn) {
              allBtn.classList.remove('active');
              allBtn.setAttribute('aria-pressed', 'false');
            }
          } else if (action === 'reset') {
            cy.elements().removeClass('highlighted faded hover hover-connected dimmed');
            cy.fit(null, 30);
          }
        });
      });
    }

    // Listen for theme changes
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'data-theme') {
          updateGraphColors();
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });

    // Listen for external highlight events (sync with blog cards)
    // Debounced + de-duplicated so fast successive hovers (scrolling a list)
    // don't queue up multiple camera pans and cause jitter.
    let highlightDebounce = null;
    let activeHighlightId = null;

    function applyHighlight(postId) {
      // Find the node by matching the slugId
      const node = cy.nodes('[type="post"]').filter(n => {
        const slugId = n.data('slugId') || '';
        return slugId === postId;
      }).first();

      if (!node || node.length === 0) return;
      if (activeHighlightId === postId) return; // already focused, skip re-pan
      activeHighlightId = postId;

      const connected = node.connectedEdges().connectedNodes();
      const connectedEdges = node.connectedEdges();

      cy.elements().removeClass('hover hover-connected dimmed highlighted faded');
      node.addClass('hover highlighted');
      connected.addClass('hover-connected');
      connectedEdges.addClass('hover-connected');
      cy.elements().not(node).not(connected).not(connectedEdges).addClass('dimmed');

      // Stop any in-flight pan before starting a new one, otherwise queued
      // animations fight each other and the camera visibly stutters.
      cy.stop(true, false);
      cy.animate({
        center: { eles: node },
        duration: 250,
        easing: 'ease-out'
      });
    }

    window.addEventListener('graph-highlight-post', function(e) {
      const postId = e.detail?.postId;
      if (!postId) return;
      if (highlightDebounce) clearTimeout(highlightDebounce);
      highlightDebounce = setTimeout(() => applyHighlight(postId), 60);
    });

    window.addEventListener('graph-clear-highlight', function() {
      if (highlightDebounce) {
        clearTimeout(highlightDebounce);
        highlightDebounce = null;
      }
      activeHighlightId = null;
      cy.elements().removeClass('hover hover-connected dimmed highlighted faded');
    });

    // Store cy instance for external access
    window.graphCyInstance = cy;
  }

  // Start initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGraph);
  } else {
    initGraph();
  }
</script>
